{
  "name": "temvra-desktop",
  "productName": "Temvra",
  "version": "1.0.0",
  "private": true,
  "description": "Temvra Personal para escritorio",
  "main": "main.cjs",
  "desktopName": "temvra.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux dir",
    "appimage": "electron-builder --linux AppImage",
    "win": "electron-builder --win nsis --publish never",
    "install-linux": "sh install-linux.sh"
  },
  "build": {
    "appId": "com.temvra.app.personal.desktop",
    "productName": "Temvra",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "preload-widget.cjs",
      "vault-dir.cjs",
      {
        "from": "../www",
        "to": "www"
      },
      {
        "from": "../resources",
        "to": ".",
        "filter": [
          "icon-512.png"
        ]
      }
    ],
    "win": {
      "icon": "../resources/icon-512.png",
      "artifactName": "Temvra-Personal-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Temvra"
    },
    "linux": {
      "executableName": "temvra",
      "icon": "../resources/icon-512.png",
      "category": "Utility"
    },
    "protocols": [
      {
        "name": "Temvra",
        "schemes": [
          "temvra"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
