<?xml version="1.0" encoding="utf-8"?>
<!-- Cristal: fondo translúcido sobre el fondo de pantalla, borde que capta la luz y brillo en el canto superior -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#B80C0C10"/><corners android:radius="24dp"/></shape></item>
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#22FFFFFF" android:centerColor="#05FFFFFF" android:endColor="#00000000"/><corners android:radius="24dp"/></shape></item>
    <item><shape android:shape="rectangle"><stroke android:width="1dp" android:color="#2EFFFFFF"/><corners android:radius="24dp"/></shape></item>
</layer-list>
