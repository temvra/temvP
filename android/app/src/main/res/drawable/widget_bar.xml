<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="4dp"/><solid android:color="#4A3A3F4D"/><stroke android:width="1dp" android:color="#14FFFFFF"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><corners android:radius="4dp"/><gradient android:angle="0" android:startColor="#FFFFFFFF" android:centerColor="#FFC6C4F4" android:endColor="#FFB8B5FF"/></shape></clip>
    </item>
</layer-list>
