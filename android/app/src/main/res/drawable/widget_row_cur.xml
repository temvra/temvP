<?xml version="1.0" encoding="utf-8"?>
<!-- Elemento principal: lente de color que emite luz -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#B8302D80"/><corners android:radius="14dp"/></shape></item>
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#40FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#1A000000"/><corners android:radius="14dp"/></shape></item>
    <item><shape android:shape="rectangle"><stroke android:width="1dp" android:color="#55C6C4F4"/><corners android:radius="14dp"/></shape></item>
</layer-list>
