<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.5" android:thicknessRatio="16" android:useLevel="false">
            <solid android:color="#3A3F4D"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <shape android:shape="ring" android:innerRadiusRatio="2.5" android:thicknessRatio="16" android:useLevel="true">
            <solid android:color="#B8B5FF"/>
        </shape>
    </item>
</layer-list>
