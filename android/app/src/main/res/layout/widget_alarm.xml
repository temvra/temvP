<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_alarm_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:id="@+id/wa_headrow" android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
            <TextView android:id="@+id/wa_head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alarmas" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/wa_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#A0A0A8" android:textSize="11.5sp" />
        </LinearLayout>
        <ImageView android:id="@+id/wa_add" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_pill" android:padding="9dp" android:contentDescription="Nueva alarma" android:src="@drawable/ic_w_add" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/wa_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="3dp" android:scrollbars="none" />
        <TextView android:id="@+id/wa_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Sin alarmas" android:textColor="#A0A0A8" />
    </FrameLayout>
</LinearLayout>
