<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#F4F4F6" android:textSize="14sp" />
    <TextView android:id="@+id/w_lap" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#C6C4F4" android:textSize="12sp" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <Chronometer android:id="@+id/w_chrono" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="sans-serif-light" android:gravity="center" android:textColor="#F4F4F6" android:textSize="42sp" />
        <TextView android:id="@+id/w_static" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="sans-serif-light" android:gravity="center" android:maxLines="1" android:textColor="#F4F4F6" android:textSize="42sp" />
    </FrameLayout>

    <ProgressBar android:id="@+id/w_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginBottom="8dp" android:max="100" android:progressDrawable="@drawable/widget_bar" />

    <LinearLayout android:id="@+id/w_btns" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <ImageView android:id="@+id/w_reset" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/widget_pill" android:contentDescription="Reiniciar" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_w_reset" />
        <ImageView android:id="@+id/w_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1.4" android:background="@drawable/widget_btn" android:contentDescription="Pausar o reanudar" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_w_play" />
        <ImageView android:id="@+id/w_skip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_pill" android:contentDescription="Saltar vuelta" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_w_skip" />
    </LinearLayout>
</LinearLayout>
