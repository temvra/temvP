<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/wl_head"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/wl_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#C6C4F4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wl_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#A0A0A8"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/wl_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Añadir"
            android:padding="9dp"
            android:src="@drawable/ic_w_add" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/wl_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/wl_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#A0A0A8"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
