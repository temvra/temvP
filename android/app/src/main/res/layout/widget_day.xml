<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_day_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Hoy"
        android:textColor="#A9ABB8"
        android:textSize="12sp"/>

    <ProgressBar
        android:id="@+id/w_day_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="1440"
        android:progress="0"
        android:progressDrawable="@drawable/widget_bar"/>

    <TextView
        android:id="@+id/w_day_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text=""
        android:textColor="#A9ABB8"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/w_day_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Nada más por hoy"
        android:textColor="#E3E2EA"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/w_day_next2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#A9ABB8"
        android:textSize="12sp"/>
</LinearLayout>
