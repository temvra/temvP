<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wn_vault" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="6dp" android:textSize="17sp" android:textStyle="bold" />
        <ImageView android:id="@+id/wn_zoom" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_pill" android:padding="9dp" android:layout_marginEnd="4dp" android:contentDescription="Agrandar" android:src="@drawable/ic_w_zoom" />
        <ImageView android:id="@+id/wn_add" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_pill" android:padding="9dp" android:contentDescription="Nueva nota" android:src="@drawable/ic_w_add" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/wn_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:scrollbars="none" />
        <TextView android:id="@+id/wn_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Sin notas" android:textColor="#A0A0A8" />
    </FrameLayout>
</LinearLayout>
