<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wt_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="38dp" android:orientation="horizontal">
    <TextView android:id="@+id/wt_mark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="18dp" android:textSize="14sp" />
    <TextView android:id="@+id/wt_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="14sp" />
    <TextView android:id="@+id/wt_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#77777E" android:textSize="12sp" />
</LinearLayout>
