<?xml version="1.0" encoding="utf-8"?>
<!-- «Ahora»: la hora con segundos, el rayo del día y la cuenta atrás de los dos próximos eventos -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wp_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_pulse_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="12dp" android:paddingEnd="18dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
            <TextClock android:id="@+id/wp_hm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:fontFamily="sans-serif-thin" android:includeFontPadding="false" android:letterSpacing="-0.02" android:textColor="#F6F6FA" android:textSize="56sp" />
            <TextClock android:id="@+id/wp_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginBottom="6dp" android:format12Hour="ss" android:format24Hour="ss" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:shadowColor="#CCFF3B43" android:shadowRadius="14" android:textColor="#FF787C" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:orientation="horizontal" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="end" android:orientation="vertical">
                <TextClock android:id="@+id/wp_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEE d MMM" android:format24Hour="EEE d MMM" android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" android:textAllCaps="true" android:textColor="#F6F6FA" android:textSize="12sp" />
                <TextView android:id="@+id/wp_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:textColor="#8FF6F6FA" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="8dp">
            <ImageView android:layout_width="match_parent" android:layout_height="2dp" android:layout_gravity="center_vertical" android:scaleType="fitXY" android:src="@drawable/wp_track" android:importantForAccessibility="no" />
            <LinearLayout android:id="@+id/wp_lzw" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/wp_lz" android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:scaleType="fitXY" android:src="@drawable/wp_laser" android:importantForAccessibility="no" />
                <FrameLayout android:layout_width="14dp" android:layout_height="14dp">
                    <ImageView android:id="@+id/wp_halo" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/wp_halo" android:importantForAccessibility="no" />
                    <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_gravity="center" android:src="@drawable/wp_core" android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/wp_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.16" android:text="PRÓXIMOS" android:textColor="#8FF6F6FA" android:textSize="10sp" />
        <LinearLayout android:id="@+id/wp_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/wp_row" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
            <ImageView android:id="@+id/wp_d1" android:layout_width="4dp" android:layout_height="30dp" android:scaleType="fitXY" android:src="@drawable/wp_bar" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/wp_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#F6F6FA" android:textSize="15sp" />
                <TextView android:id="@+id/wp_w1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#8FF6F6FA" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="end" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="EN" android:textColor="#8FF6F6FA" android:textSize="9sp" />
                <Chronometer android:id="@+id/wp_c1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#FF787C" android:textSize="17sp" />
                <TextView android:id="@+id/wp_x1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#FF787C" android:textSize="15sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/wp_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:alpha="0.75" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp">
            <ImageView android:id="@+id/wp_d2" android:layout_width="4dp" android:layout_height="26dp" android:scaleType="fitXY" android:src="@drawable/wp_bar" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/wp_t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#F6F6FA" android:textSize="14sp" />
                <TextView android:id="@+id/wp_w2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#8FF6F6FA" android:textSize="11.5sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="end" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="EN" android:textColor="#8FF6F6FA" android:textSize="9sp" />
                <Chronometer android:id="@+id/wp_c2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#FF787C" android:textSize="15sp" />
                <TextView android:id="@+id/wp_x2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#FF787C" android:textSize="14sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/wp_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nada más en el horizonte ✦" android:textColor="#8FF6F6FA" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
