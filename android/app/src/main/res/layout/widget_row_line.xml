<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="19dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <TextView android:id="@+id/wl_hour" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textSize="12.5sp" />
        <TextView android:id="@+id/wl_c0" style="@style/WlCell" />
        <TextView android:id="@+id/wl_c1" style="@style/WlCell" />
        <TextView android:id="@+id/wl_c2" style="@style/WlCell" />
        <TextView android:id="@+id/wl_c3" style="@style/WlCell" />
        <TextView android:id="@+id/wl_c4" style="@style/WlCell" />
        <TextView android:id="@+id/wl_c5" style="@style/WlCell" />
    </LinearLayout>

    <ImageView android:id="@+id/wl_rule" android:layout_width="match_parent" android:layout_height="1.5dp" android:contentDescription="@null" />
</FrameLayout>
